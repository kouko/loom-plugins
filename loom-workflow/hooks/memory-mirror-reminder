#!/usr/bin/env python3
"""PostToolUse hook (Write|Edit|Bash): remind the agent to classify a host memory note.

A host memory note is a `.md` file directly inside `<config>/projects/<slug>/memory/`
(config = $CLAUDE_CONFIG_DIR, plus any `.claude` directory). The index
`MEMORY.md` is silent. A Bash command counts when one of its whitespace- or
shell-punctuation-separated tokens is such a path; a write through a variable
or a script file is not seen. Path-only: the note's content is never read.
Anything else, or any error, prints nothing. Always exits 0. Stdlib only.
"""

import json
import os
import re
import sys

REMINDER = (
    "You just wrote a host memory note. Host memory is per-machine and not "
    "committed. Classify it with loom-workflow:loom-memory's Record "
    "classification: a lesson that holds for any contributor cloning this "
    "repository on another machine with other tools goes to the repo's "
    "committed store (`docs/loom/memory/`) via loom-memory; personal, machine-specific or "
    "agent-tool-specific notes stay only in host memory. Zero to one durable "
    "lesson per change is normal. If this branch's closing review already "
    "generated its attestation (finalize-review ran), do not write the repo "
    "store now; keep the lesson in host memory for the next change's branch."
)


def is_memory_note(path):
    if not path.endswith(".md"):
        return False
    path = os.path.normpath(path)
    parent, name = os.path.split(path)
    if name.lower() == "memory.md" or os.path.basename(parent) != "memory":
        return False
    projects = os.path.dirname(os.path.dirname(parent))
    if os.path.basename(projects) != "projects":
        return False
    config = os.path.dirname(projects)
    if os.path.basename(config) == ".claude":
        return True
    env = os.environ.get("CLAUDE_CONFIG_DIR")
    return bool(env) and os.path.normpath(os.path.expanduser(env)) == config


def main():
    try:
        data = json.loads(sys.stdin.read())
        tool_input = data["tool_input"]
        command = tool_input.get("command")
        if isinstance(command, str):
            paths = [os.path.expanduser(t) for t in re.split(r"[\s;&|<>()'\"]+", command)]
        else:
            paths = [tool_input["file_path"]]
        if any(isinstance(p, str) and is_memory_note(p) for p in paths):
            out = {"hookSpecificOutput": {"hookEventName": "PostToolUse",
                                          "additionalContext": REMINDER}}
            sys.stdout.write(json.dumps(out) + "\n")
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
