#!/usr/bin/env python3
"""SessionStart hook: print the loom-visualization trigger card.

Prints the coexistence card when ascii-graph-toolkit is active for this
project (so only one diagram trigger instruction reaches the session),
otherwise the full card. Any error prints the full card. Always exits 0.

Output shape follows loom-code/hooks/session-start: canonical
hookSpecificOutput.additionalContext plus defensive `additional_context`
and bare `additionalContext`. Stdlib only.
"""

import json
import os
import sys

TOOLKIT_PREFIX = "ascii-graph-toolkit@"
FULL = "trigger-card.md"
COEXIST = "trigger-card-coexist.md"


def _load_json(path, missing_ok):
    """Parsed JSON object, {} when missing and allowed; raises when unreadable."""
    if missing_ok and not os.path.exists(path):
        return {}
    with open(path, encoding="utf-8") as fh:
        data = json.load(fh)
    if not isinstance(data, dict):
        raise ValueError("not a JSON object: " + path)
    return data


def _same_path(a, b):
    return os.path.realpath(os.path.expanduser(a)) == os.path.realpath(os.path.expanduser(b))


def toolkit_active(hook_input):
    config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    installed = _load_json(os.path.join(config, "plugins", "installed_plugins.json"), False)
    plugins = installed.get("plugins")
    if not isinstance(plugins, dict):
        return False
    keys = [k for k in plugins if isinstance(k, str) and k.startswith(TOOLKIT_PREFIX)]
    if not keys:
        return False

    root = os.environ.get("CLAUDE_PROJECT_DIR") or hook_input.get("cwd") or os.getcwd()
    enabled = {}
    for path in (os.path.join(config, "settings.json"),
                 os.path.join(root, ".claude", "settings.json"),
                 os.path.join(root, ".claude", "settings.local.json")):
        layer = _load_json(path, True).get("enabledPlugins", {})
        if not isinstance(layer, dict):
            raise ValueError("enabledPlugins is not an object: " + path)
        enabled.update(layer)

    for key in keys:
        if enabled.get(key) is not True:
            continue
        entries = plugins[key]
        if not isinstance(entries, list):
            continue
        for entry in entries:
            if not isinstance(entry, dict):
                continue
            scope = entry.get("scope")
            if scope == "user":
                return True
            project_path = entry.get("projectPath")
            if scope in ("project", "local") and isinstance(project_path, str) \
                    and _same_path(project_path, root):
                return True
    return False


def _assets_dirs():
    here = os.path.dirname(os.path.realpath(__file__))
    dirs = []
    plugin_root = os.environ.get("CLAUDE_PLUGIN_ROOT")
    if plugin_root:
        dirs.append(os.path.join(plugin_root, "skills", "loom-visualization", "assets"))
    dirs.append(os.path.join(here, "..", "skills", "loom-visualization", "assets"))
    return dirs


def _read_card(name):
    for d in _assets_dirs():
        try:
            with open(os.path.join(d, name), encoding="utf-8") as fh:
                return fh.read()
        except OSError:
            continue
    raise OSError("card not found: " + name)


def main():
    context = ""
    try:
        try:
            hook_input = json.loads(sys.stdin.read() or "{}")
        except (ValueError, OSError):
            hook_input = {}
        if not isinstance(hook_input, dict):
            hook_input = {}
        try:
            name = COEXIST if toolkit_active(hook_input) else FULL
        except Exception:
            name = FULL
        context = _read_card(name)
    except Exception:
        try:
            context = _read_card(FULL)
        except Exception:
            context = ""
    sys.stdout.write(json.dumps({
        "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": context},
        "additional_context": context,
        "additionalContext": context,
    }) + "\n")
    return 0


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
