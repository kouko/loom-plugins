{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/session-start\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/loom-python\" --ready push --hook; status=$?; if [ \"$status\" -eq 86 ]; then printf '{\"systemMessage\":\"loom: publication hook failed (checker runtime unavailable; run loom-python --repair in an agent station); allowing.\"}\\n'; exit 0; fi; exit \"$status\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/loom-python\" --ready --script ../hooks/language-anchor.py"
          }
        ]
      }
    ]
  }
}
