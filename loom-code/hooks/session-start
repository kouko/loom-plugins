#!/usr/bin/env bash
# SessionStart hook for loom-code (concept-model §4, §7a; plan W0-05 / REQ-8).
#
# What it injects, and nothing else:
#   1. one line naming the station order,
#   2. one paragraph naming which requests enter loom (in any repo),
#   3. the three human decision points in plain words,
#   4. a pointer to the entry station's SKILL.md for the full summary table,
#   5. the repo's KICKOFF-DEFAULTS lines when that file exists.
#
# Station names and decision-point owners are DERIVED at runtime from
# loom-code/contract/manifest.yaml — the contract package is the single
# source; this script must never carry a second hand-typed copy.
#
# Budget: `bash loom-code/hooks/session-start </dev/null | python3 -c
# 'import sys;print(len(sys.stdin.read().split()))'` with cwd = an empty
# git repo must stay <= 2639 words (half of the 923fb84a baseline of 5278).
# Python str.split(): BSD and GNU wc disagree on this output in every
# locale. Guarded by tests/test_session_start_words.py.
#
# Output key: only hookSpecificOutput.additionalContext, on every host
# (Claude Code, Codex, agy_adapter.py, the OpenCode loader). Codex marks a
# hook Failed when its JSON carries any other top-level key.
#
# Escape hatch: export LOOM_CODE_MODE=off  # no-op JSON, no injection.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MANIFEST="${SCRIPT_DIR}/../contract/manifest.yaml"

emit_empty() {
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""}}\n'
}

if [ "${LOOM_CODE_MODE:-on}" = "off" ]; then
  emit_empty
  exit 0
fi

# Manifest missing → fail open (never crash the session).
if [ ! -f "${MANIFEST}" ]; then
  emit_empty
  exit 0
fi

# --- derived from the contract package ------------------------------------
# One `- {name: <station>, ...}` line per station, in manifest order.
stations_block() {
  awk '/^stations:/{f=1;next} /^[a-z_]+:/{f=0} f' "${MANIFEST}"
}

station_names="$(stations_block | sed -n 's/^[[:space:]]*-[[:space:]]*{name:[[:space:]]*\([a-z0-9-]*\).*/\1/p')"

# Stations owning a given decision point, joined by " / ".
stations_for_dp() {
  stations_block \
    | { grep "decision_point: $1" || true; } \
    | sed -n 's/^[[:space:]]*-[[:space:]]*{name:[[:space:]]*\([a-z0-9-]*\).*/\1/p' \
    | paste -sd@ - | sed 's/@/ \/ /g'
}

flow=""
tail_station=""
for name in ${station_names}; do
  if [ "${name}" = "maintain" ]; then
    tail_station="${name}"
    continue
  fi
  if [ -z "${flow}" ]; then flow="${name}"; else flow="${flow} → ${name}"; fi
done

dp1="$(stations_for_dp 1)"
dp2="$(stations_for_dp 2)"
dp3="$(stations_for_dp 3)"

entry_station="${dp1%% *}"
# The last decision-point-1 owner runs ① itself when loom-design is absent.
fallback_station="${dp1##* }"

# --- the injected body ----------------------------------------------------
body="You have loom-code. Software-development work runs through stations, one artifact each.

Station order: ${flow}; ${tail_station} on alerts.

Any software-development request that adds a feature or fixes a bug starts at ${entry_station} (${fallback_station} when loom-design is not installed) before you edit any file — in any repository, even when the user never says loom and there is no docs/loom folder. A user asking for a bug to be fixed starts there too, even when it reads as a bug report; ${tail_station} takes alerts, CI or regression failures and dogfood incidents that arrive outside an active change without a user's fix request. Outside an active change, a feature or bug-fix request goes through loom however small; inside one, the work continues in that change's station. Other edits that add no feature and fix no bug (a typo, a rename that changes no behaviour, comment or doc wording) and work that is not software development (research, notes) go direct unless the user asks for loom.

You ask the user exactly three times. Everything else you decide yourself and record the reason as agent-decided:
① after the intent is written (${dp1}) — restate the problem and the acceptance conditions in plain words and get \"yes, this is what I want\"; fold a missing-principles interview, any \`second-vendor: ask\` question, and (engineering changes) any one-way-door choice into this same conversation.
② only for a product change, after the spec is written (${dp2}) — read back the visible behaviour (\"you type X, you see Y\") and get \"yes\"; product one-way-door choices and irreversible actions on existing data are asked here, not in ①; never show design rationale.
③ at the end (${dp3}) — the user reads the acceptance test report, one line per acceptance condition, and accepts. They never review a diff.

Never ask the user to judge spec quality, plan shape, or a review verdict — they cannot, and the machines are the reviewers.

With \`second-vendor: suggest\`, after the plan's risk evidence exists, mention an available other-vendor reviewer according to the write-plan policy; work continues without waiting. This is visibility, not a fourth decision point.

The full station summary table (what each station reads, produces, and when the checker and the checkpoints fire) lives in the entry station's SKILL.md: ${entry_station}, or ${fallback_station} when loom-design is not installed. Load it there; it is not repeated here."

# --- repo defaults --------------------------------------------------------
DEFAULTS_FILE="docs/loom/KICKOFF-DEFAULTS.md"
if [ -f "${DEFAULTS_FILE}" ]; then
  # Turn vertical tab and form feed into spaces, delete the other control
  # bytes (tab and newline kept), then drop invalid UTF-8, before sed matches.
  # POSIX iconv -c omits invalid input characters; glibc, libiconv and BSD
  # may still exit non-zero, and iconv may be missing, so `|| cat` drains
  # stdin (EOF after -c consumed it) and the hook still exits 0. Without
  # iconv, invalid bytes pass through unfiltered; sed runs under LC_ALL=C
  # so such a byte cannot make it fail.
  defaults="$(LC_ALL=C tr '\013\014' '  ' < "${DEFAULTS_FILE}" \
    | LC_ALL=C tr -d '\000-\010\015-\037\177' \
    | { iconv -c -f UTF-8 -t UTF-8 2>/dev/null || cat; } \
    | LC_ALL=C sed -n 's/^-[[:space:]]\{1,\}\(.*: .*\)$/- \1/p')"
  if [ -n "${defaults}" ]; then
    body="${body}

This repo's standing defaults (docs/loom/KICKOFF-DEFAULTS.md):
${defaults}"
  fi
fi

# JSON-escape via bash parameter substitution.
escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}
context="$(escape_for_json "${body}")"

printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "${context}"
