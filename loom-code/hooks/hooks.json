{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start\"",
            "async": false
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/language-anchor.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PLUGIN_ROOT}/scripts/loom_checker.py\" ]; then exec python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/loom_checker.py\" push --hook; else cat >/dev/null; echo \"loom: publication hook failed (installed checker is unavailable at ${CLAUDE_PLUGIN_ROOT}/scripts/loom_checker.py; restart Claude Code to load the installed plugin version); allowing.\" >&2; exit 0; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/language-anchor.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/language-anchor.py\""
          }
        ]
      }
    ]
  }
}
